{
  "name": "silicone-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build && npm run capture:previews",
    "capture:previews": "node scripts/capture-previews.mjs",
    "test:visual": "playwright test --config playwright.config.ts",
    "test:visual:update": "playwright test --config playwright.config.ts --update-snapshots",
    "preview": "vite preview"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "solid-js": "1.9.15",
    "solid-silicone": "file:../packages/silicone"
  },
  "devDependencies": {
    "@globetrotte/altimeter": "^0.0.5",
    "@playwright/test": "^1.63.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-solid": "2.11.14"
  }
}
